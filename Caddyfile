{
	email {$SSL_EMAIL}
}

# Note: double colon syntax {$VAR::default} sets default to ":80" (port 80);
# single colon would treat "80" as a bare hostname. This ensures local dev gets HTTP on :80.
{$SITE_ADDRESS::80} {
	encode gzip zstd

	handle /health {
		respond "healthy" 200
	}

	handle /api/admin/* {
		reverse_proxy frontend:3000
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /swagger/* {
		reverse_proxy backend:8080
	}

	handle /certifications/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
